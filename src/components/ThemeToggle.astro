---
const isBlog = Astro.url.pathname.startsWith('/blog');
---

<div
  id="status-bar"
  data-stuck="false"
  data-blog={isBlog ? 'true' : 'false'}
  class="border border-ctp-surface1 bg-ctp-surface0/20 flex flex-nowrap items-stretch
    divide-x divide-ctp-surface1 text-xs font-mono select-none w-full max-w-full overflow-hidden"
>
  <div
    class="hidden min-[480px]:flex items-center justify-center gap-1.5 px-3 py-1.5
      text-ctp-text font-medium whitespace-nowrap shrink-0"
  >
    <span
      class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] inline-block animate-pulse
        shrink-0 transition-colors duration-300"
    ></span>
    <span>v1.1.0</span>
  </div>

  <div
    id="ascii-scroll-container"
    class="flex-1 min-w-0 flex items-center justify-center px-1 sm:px-2 py-1.5 overflow-hidden"
  >
    <span
      id="ascii-idle-bar"
      class={`${isBlog ? 'hidden' : 'inline-block'} font-mono text-xs select-none tracking-wider
        sm:tracking-widest whitespace-nowrap overflow-hidden`}
      aria-hidden="true"
    ><span class="text-ctp-surface2 opacity-30">···</span><span
      class="text-ctp-overlay0 opacity-45">~~</span><span
      class="text-[var(--color-accent)] opacity-60">░</span><span
      class="text-[var(--color-accent)] opacity-80">▒</span><span
      class="text-[var(--color-accent)] opacity-95">▓</span><span
      class="text-[var(--color-accent)]">█</span><span
      class="text-[var(--color-accent)] opacity-95">▓</span><span
      class="text-[var(--color-accent)] opacity-80">▒</span><span
      class="text-[var(--color-accent)] opacity-60">░</span><span
      class="text-ctp-overlay0 opacity-45">~~</span><span
      class="text-ctp-surface2 opacity-30">·····</span></span>
  </div>

  <button
    id="accent-toggle"
    type="button"
    class="flex items-center justify-center gap-1 sm:gap-1.5 px-2 sm:px-3 py-1.5 text-ctp-subtext1
      hover:text-ctp-text hover:bg-ctp-surface1/30 transition-colors cursor-pointer
      focus:outline-none whitespace-nowrap shrink-0"
    aria-label="Cycle Accent Color"
    title="Cycle accent color (or press 'a')"
  >
    <span
      id="accent-indicator"
      class="w-1.5 h-1.5 rounded-full shrink-0 ring-1 ring-ctp-surface1 transition-colors"
    ></span>
    <span class="text-ctp-subtext0">[a]</span>
    <span
      id="accent-label"
      class="hidden min-[480px]:inline-block text-ctp-text font-medium w-[6ch] text-left"
    >peach</span>
  </button>

  <button
    id="theme-toggle"
    type="button"
    class="flex items-center justify-center gap-1 sm:gap-1.5 px-2 sm:px-3 py-1.5 text-ctp-subtext1
      hover:text-ctp-text hover:bg-ctp-surface1/30 transition-colors cursor-pointer
      focus:outline-none whitespace-nowrap shrink-0"
    aria-label="Toggle Theme"
    title="Toggle light/dark/device theme (or press 't')"
  >
    <span
      class="text-[11px] text-[var(--color-accent)] font-semibold leading-none select-none"
    >◐</span>
    <span class="text-ctp-subtext0">[t]</span>
    <span
      id="theme-label"
      class="hidden min-[480px]:inline-block text-ctp-text font-medium w-[6ch] text-left"
    >device</span>
  </button>

  <div
    id="eyeline-group"
    class={`${isBlog ? 'flex' : 'hidden'} items-center justify-center gap-1 sm:gap-2 px-1.5 sm:px-2.5 py-1.5 whitespace-nowrap shrink-0`}
  >
    <div class="flex items-center gap-1">
      <span class="hidden min-[460px]:inline text-ctp-subtext0 font-medium">eyeline</span>
      <button
        id="eyeline-toggle"
        type="button"
        class="flex items-center gap-1 text-ctp-subtext1 hover:text-ctp-text transition-colors cursor-pointer focus:outline-none"
        aria-label="Toggle Eyeline"
        title="Toggle reading eyeline (or press 'e')"
      >
        <span class="text-ctp-subtext0">[e]</span>
        <span id="eyeline-label" class="text-ctp-text font-medium w-[3ch] inline-block text-left">on</span>
      </button>
    </div>

    <span class="text-ctp-surface2 select-none opacity-60">•</span>

    <button
      id="eyeline-opacity-toggle"
      type="button"
      class="flex items-center gap-1 text-ctp-subtext1 hover:text-ctp-text transition-colors cursor-pointer focus:outline-none"
      aria-label="Cycle Eyeline Opacity"
      title="Cycle eyeline opacity (or press 'o')"
    >
      <span class="text-ctp-subtext0">[o]</span>
      <span class="hidden sm:inline text-ctp-subtext0">opacity</span>
      <span class="hidden min-[440px]:inline sm:hidden text-ctp-subtext0">op</span>
      <span id="eyeline-opacity-label" class="text-ctp-text font-medium w-[4ch] inline-block text-left">80%</span>
    </button>

    <span class="text-ctp-surface2 select-none opacity-60">•</span>

    <button
      id="eyeline-pos-toggle"
      type="button"
      class="flex items-center gap-1 text-ctp-subtext1 hover:text-ctp-text transition-colors cursor-pointer focus:outline-none"
      aria-label="Cycle Eyeline Position"
      title="Cycle eyeline position (or press 'p')"
    >
      <span class="text-ctp-subtext0">[p]</span>
      <span class="hidden sm:inline text-ctp-subtext0">position at</span>
      <span class="hidden min-[440px]:inline sm:hidden text-ctp-subtext0">pos</span>
      <span id="eyeline-pos-label" class="text-ctp-text font-medium w-[3ch] inline-block text-left">30%</span>
    </button>
  </div>

  <div
    class={`${isBlog ? 'hidden' : 'flex'} items-center justify-center px-2 sm:px-3 py-1.5
      text-ctp-subtext0 whitespace-nowrap shrink-0`}
  >
    <span id="ist-clock">--:--:-- IST</span>
  </div>
</div>

<style>
  #status-bar {
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }

  #status-bar[data-blog="true"][data-stuck="false"] #ascii-idle-bar {
    display: none !important;
  }

  #status-bar[data-blog="true"][data-stuck="false"] #ascii-scroll-container {
    display: none !important;
  }

  #status-bar[data-blog="true"][data-stuck="false"] #eyeline-group {
    flex: 1 1 0% !important;
  }

  #status-bar[data-blog="true"][data-stuck="true"] #ascii-idle-bar {
    display: inline-block !important;
  }

  #status-bar[data-blog="true"][data-stuck="true"] #ascii-scroll-container {
    display: flex !important;
  }

  #status-bar[data-blog="true"][data-stuck="true"] #eyeline-group {
    flex: 0 0 auto !important;
  }

  #status-bar[data-stuck="true"] {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    max-width: 100vw;
    z-index: 50;
    border-top: none;
    border-left: none;
    border-right: none;
    border-bottom: 1px solid var(--color-ctp-surface1);
    background-color: color-mix(in srgb, var(--color-ctp-base) 94%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: none;
    animation: statusBarSlideDown 150ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes statusBarSlideDown {
    from {
      transform: translateY(-100%);
      opacity: 0.8;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>

<script>
  const accents = ['peach', 'mono', 'yellow', 'mauve', 'blue', 'green'];

  let cachedCharWidth = 0;
  let cachedIdleCapacity = 0x16;
  let idleAnimationTimer: number | null = null;
  let idleFrame = 0;

  function renderIdleAscii(capacity: number, frame: number): string {
    const center = (capacity - 1) / 2;
    const maxDist = Math.max(center, 1);
    const period = 0x24; // 36 frames (~2s full out-in-out cycle)
    const cycle = (frame % period) / period;
    const rippleR = maxDist * (0.5 + 0.5 * Math.cos(cycle * 2 * Math.PI));

    let html = '';
    let curCls = '';
    let curChars = '';

    for (let i = 0; i < capacity; i++) {
      const d = Math.abs(i - center);
      let ch = '·';
      let baseCls = 'text-ctp-surface2 opacity-25';

      if (d < 0.8) {
        ch = '█';
        baseCls = 'text-[var(--color-accent)] opacity-40';
      } else if (d < 1.8) {
        ch = '▓';
        baseCls = 'text-[var(--color-accent)] opacity-30';
      } else if (d < 2.8) {
        ch = '▒';
        baseCls = 'text-ctp-overlay0 opacity-40';
      } else if (d < 3.8) {
        ch = '░';
        baseCls = 'text-ctp-surface2 opacity-45';
      } else if (d < 5.8) {
        ch = '~';
        baseCls = 'text-ctp-surface2 opacity-35';
      }

      const distToRipple = Math.abs(d - rippleR);
      const glow = Math.max(0, 1 - distToRipple / 2.2);

      let cls = baseCls;
      if (glow >= 0.7) {
        cls = 'text-[var(--color-accent)] opacity-100';
      } else if (glow >= 0.35) {
        cls = 'text-[var(--color-accent)] opacity-75';
      } else if (glow >= 0.1) {
        cls = 'text-[var(--color-accent)] opacity-50';
      }

      if (cls === curCls) {
        curChars += ch;
      } else {
        if (curChars) {
          html += `<span class="${curCls}">${curChars}</span>`;
        }
        curCls = cls;
        curChars = ch;
      }
    }
    if (curChars) {
      html += `<span class="${curCls}">${curChars}</span>`;
    }
    return html;
  }

  function tickIdleAnimation() {
    const idleEl = document.getElementById('ascii-idle-bar');
    if (!idleEl) return;
    const capacity = cachedIdleCapacity;
    if (capacity >= 4) {
      idleEl.innerHTML = renderIdleAscii(capacity, idleFrame);
      idleEl.style.display = 'inline-block';
      idleFrame = (idleFrame + 1) % 0x2710;
    } else {
      idleEl.innerHTML = '';
      idleEl.style.display = 'none';
    }
  }

  function shouldAnimateIdle(): boolean {
    const onBlog = window.location.pathname.startsWith('/blog');
    if (!onBlog) return true;
    const bar = document.getElementById('status-bar');
    return bar?.getAttribute('data-stuck') === 'true';
  }

  function startIdleAnimation() {
    if (!shouldAnimateIdle() || idleAnimationTimer !== null) return;
    tickIdleAnimation();
    idleAnimationTimer = window.setInterval(tickIdleAnimation, 0x41);
  }

  function stopIdleAnimation() {
    if (idleAnimationTimer !== null) {
      clearInterval(idleAnimationTimer);
      idleAnimationTimer = null;
    }
  }

  const themes = ['device', 'dark', 'latte'];

  function getStoredTheme(): string {
    const stored = localStorage.getItem('theme');
    if (stored && themes.includes(stored)) return stored;
    localStorage.setItem('theme', 'device');
    return 'device';
  }

  function applyTheme(themeName: string) {
    localStorage.setItem('theme', themeName);

    let effective = themeName;
    if (themeName === 'device') {
      const prefersLight =
        window.matchMedia &&
        window.matchMedia('(prefers-color-scheme: light)').matches;
      effective = prefersLight ? 'latte' : 'dark';
    }

    if (effective === 'latte') {
      document.documentElement.classList.remove('dark', 'macchiato');
      document.documentElement.classList.add('latte');
    } else {
      document.documentElement.classList.remove('latte');
      document.documentElement.classList.add('dark', 'macchiato');
    }

    const themeLabel = document.getElementById('theme-label');
    if (themeLabel) {
      themeLabel.textContent = themeName;
    }

    applyAccent(getStoredAccent());
  }

  function getStoredAccent(): string {
    const stored = localStorage.getItem('accent');
    if (stored && accents.includes(stored)) return stored;
    localStorage.setItem('accent', 'peach');
    return 'peach';
  }

  function applyAccent(accentName: string) {
    document.documentElement.setAttribute('data-accent', accentName);
    localStorage.setItem('accent', accentName);

    const isLatte = document.documentElement.classList.contains('latte');
    const accentVarMap: Record<string, Record<string, string>> = {
      dark: {
        peach: 'var(--ctp-macchiato-peach)',
        mono: 'var(--ctp-macchiato-text)',
        yellow: 'var(--ctp-macchiato-yellow)',
        mauve: 'var(--ctp-macchiato-mauve)',
        blue: 'var(--ctp-macchiato-blue)',
        green: 'var(--ctp-macchiato-green)'
      },
      latte: {
        peach: 'var(--ctp-latte-peach)',
        mono: 'var(--ctp-latte-text)',
        yellow: 'var(--ctp-latte-yellow)',
        mauve: 'var(--ctp-latte-mauve)',
        blue: 'var(--ctp-latte-blue)',
        green: 'var(--ctp-latte-green)'
      }
    };
    const currentVarMap = isLatte ? accentVarMap.latte : accentVarMap.dark;
    const accentVar = currentVarMap[accentName] || currentVarMap.peach;

    const accentIndicator = document.getElementById('accent-indicator');
    if (accentIndicator) {
      accentIndicator.style.backgroundColor = accentVar;
    }
    const accentLabel = document.getElementById('accent-label');
    if (accentLabel) {
      accentLabel.textContent = accentName;
    }

    const themeLabel = document.getElementById('theme-label');
    if (themeLabel) {
      themeLabel.textContent = getStoredTheme();
    }
  }

  function updateISTClock() {
    const clockEl = document.getElementById('ist-clock');
    if (!clockEl) return;
    const now = new Date();
    const formatter = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Kolkata',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false
    });
    clockEl.textContent = `${formatter.format(now)} IST`;
  }

  function measureCharWidth(): number {
    const span = document.createElement('span');
    span.style.cssText =
      'position:absolute;visibility:hidden;white-space:nowrap;display:inline-block;width:auto;';
    span.className =
      'text-xs font-mono select-none tracking-wider sm:tracking-widest';
    span.textContent = '██████████';
    document.body.appendChild(span);
    const width = span.getBoundingClientRect().width / 10;
    document.body.removeChild(span);
    return width > 0 ? width : 7.5;
  }

  function calculateCapacity(): number {
    const container = document.getElementById('ascii-scroll-container');
    if (!container) return 0x16;

    const containerRect = container.getBoundingClientRect();
    const containerWidth = containerRect.width;
    if (containerWidth <= 0) return 0;

    if (cachedCharWidth <= 0) {
      cachedCharWidth = measureCharWidth();
    }

    const style = window.getComputedStyle(container);
    const pad =
      (parseFloat(style.paddingLeft) || 0) +
      (parseFloat(style.paddingRight) || 0);
    const availableWidth = Math.max(0, containerWidth - pad - 4);
    const totalChars = Math.floor(availableWidth / cachedCharWidth);
    return Math.max(0, totalChars);
  }

  function refreshScrollCapacity() {
    cachedCharWidth = 0;
    cachedIdleCapacity = calculateCapacity();
    tickIdleAnimation();
  }

  function updateStuckState(isStuck: boolean) {
    const bar = document.getElementById('status-bar');
    const wrap = document.getElementById('status-bar-sticky-wrap');
    if (!bar) return;
    const current = bar.getAttribute('data-stuck') === 'true';
    if (current !== isStuck) {
      bar.setAttribute('data-stuck', isStuck ? 'true' : 'false');
      wrap?.setAttribute('data-stuck', isStuck ? 'true' : 'false');
      refreshScrollCapacity();
      if (shouldAnimateIdle()) {
        startIdleAnimation();
      } else {
        stopIdleAnimation();
      }
    }
  }

  function checkStuck(): boolean {
    const sentinel = document.getElementById('status-bar-sentinel');
    const isStuck = sentinel ? sentinel.getBoundingClientRect().top <= 0 : false;
    updateStuckState(isStuck);
    return isStuck;
  }

  interface EyelineConfig {
    enabled: boolean;
    opacity: number;
    pos: number;
  }

  const EYELINE_OPACITIES = [0x28, 0x3c, 0x50, 0x64]; // 40, 60, 80, 100
  const EYELINE_POSITIONS = [0x14, 0x19, 0x1e, 0x23, 0x28, 0x2d, 0x32]; // 20, 25, 30, 35, 40, 45, 50

  function getEyelineConfig(): EyelineConfig {
    const config: EyelineConfig = { enabled: true, opacity: 0x50, pos: 0x1e };
    try {
      const saved = localStorage.getItem('pid7_eyeline');
      if (saved) {
        const parsed = JSON.parse(saved);
        if (typeof parsed.enabled === 'boolean') config.enabled = parsed.enabled;
        if (typeof parsed.opacity === 'number' && EYELINE_OPACITIES.includes(parsed.opacity)) {
          config.opacity = parsed.opacity;
        } else if (typeof parsed.opacity === 'number') {
          config.opacity = 0x50;
        }
        if (typeof parsed.pos === 'number' && EYELINE_POSITIONS.includes(parsed.pos)) {
          config.pos = parsed.pos;
        } else if (typeof parsed.pos === 'number') {
          config.pos = 0x1e;
        }
      } else {
        localStorage.setItem('pid7_eyeline', JSON.stringify(config));
      }
    } catch {}
    return config;
  }

  function applyEyelineConfig(config: EyelineConfig) {
    try {
      localStorage.setItem('pid7_eyeline', JSON.stringify(config));
    } catch {}

    const eyelineEl = document.getElementById('blog-eyeline');
    if (eyelineEl) {
      eyelineEl.style.display = config.enabled ? 'flex' : 'none';
      eyelineEl.style.opacity = (config.opacity / 100).toFixed(2);
      eyelineEl.style.top = `${config.pos}vh`;
    }

    const eyelineGroup = document.getElementById('eyeline-group');
    if (eyelineGroup) {
      if (config.enabled) {
        eyelineGroup.classList.remove('opacity-40');
      } else {
        eyelineGroup.classList.add('opacity-40');
      }
    }

    const eyelineLabel = document.getElementById('eyeline-label');
    if (eyelineLabel) {
      eyelineLabel.textContent = config.enabled ? 'on' : 'off';
      eyelineLabel.className = config.enabled
        ? 'text-ctp-text font-medium'
        : 'text-ctp-subtext0 font-medium';
    }

    const opacityBtn = document.getElementById('eyeline-opacity-toggle');
    const opacityLabel = document.getElementById('eyeline-opacity-label');
    if (opacityLabel) {
      opacityLabel.textContent = `${config.opacity}%`;
    }
    if (opacityBtn) {
      opacityBtn.title = `Cycle eyeline opacity: ${config.opacity}% (or press 'o')`;
    }

    const posBtn = document.getElementById('eyeline-pos-toggle');
    const posLabel = document.getElementById('eyeline-pos-label');
    if (posLabel) {
      posLabel.textContent = `${config.pos}%`;
    }
    if (posBtn) {
      posBtn.title = `Cycle eyeline position: ${config.pos}% (or press 'p')`;
    }
  }

  function cycleEyelineOpacity() {
    const config = getEyelineConfig();
    const curIdx = EYELINE_OPACITIES.indexOf(config.opacity);
    const nextIdx = (curIdx + 1) % EYELINE_OPACITIES.length;
    config.opacity = EYELINE_OPACITIES[nextIdx];
    config.enabled = true;
    applyEyelineConfig(config);
  }

  function cycleEyelinePosition() {
    const config = getEyelineConfig();
    const curIdx = EYELINE_POSITIONS.indexOf(config.pos);
    const nextIdx = (curIdx + 1) % EYELINE_POSITIONS.length;
    config.pos = EYELINE_POSITIONS[nextIdx];
    config.enabled = true;
    applyEyelineConfig(config);
  }

  function toggleEyeline() {
    const config = getEyelineConfig();
    config.enabled = !config.enabled;
    applyEyelineConfig(config);
  }

  function setupControls() {
    stopIdleAnimation();

    const currentAccent = getStoredAccent();
    applyAccent(currentAccent);

    const accentBtn = document.getElementById('accent-toggle');
    accentBtn?.addEventListener('click', () => {
      const active = getStoredAccent();
      const nextIndex = (accents.indexOf(active) + 1) % accents.length;
      const nextAccent = accents[nextIndex];
      applyAccent(nextAccent);
    });

    const currentTheme = getStoredTheme();
    applyTheme(currentTheme);

    const themeBtn = document.getElementById('theme-toggle');
    themeBtn?.addEventListener('click', () => {
      const active = getStoredTheme();
      const nextIndex = (themes.indexOf(active) + 1) % themes.length;
      applyTheme(themes[nextIndex]);
    });

    const onBlog = window.location.pathname.startsWith('/blog');
    const idleEl = document.getElementById('ascii-idle-bar');
    if (onBlog && idleEl) {
      const isStuck = checkStuck();
      if (!isStuck) idleEl.style.display = 'none';
    }

    const eyelineGroup = document.getElementById('eyeline-group');
    const eyelineBtn = document.getElementById('eyeline-toggle');
    const opacityBtn = document.getElementById('eyeline-opacity-toggle');
    const posBtn = document.getElementById('eyeline-pos-toggle');

    if (eyelineGroup) eyelineGroup.style.display = onBlog ? 'flex' : 'none';
    if (eyelineBtn) eyelineBtn.style.display = onBlog ? 'flex' : 'none';
    if (opacityBtn) opacityBtn.style.display = onBlog ? 'flex' : 'none';
    if (posBtn) posBtn.style.display = onBlog ? 'flex' : 'none';

    if (onBlog) {
      const config = getEyelineConfig();
      applyEyelineConfig(config);
      if (eyelineBtn) eyelineBtn.onclick = toggleEyeline;
      if (opacityBtn) opacityBtn.onclick = cycleEyelineOpacity;
      if (posBtn) posBtn.onclick = cycleEyelinePosition;
    }

    ensureClockTimer();
    refreshScrollCapacity();
    checkStuck();
    if (shouldAnimateIdle()) {
      startIdleAnimation();
    }

    const sentinel = document.getElementById('status-bar-sentinel');
    if (sentinel && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          const isStuck = !entry.isIntersecting && entry.boundingClientRect.top <= 0;
          updateStuckState(isStuck);
        },
        { threshold: [0, 1] }
      );
      observer.observe(sentinel);
    }

    const container = document.getElementById('ascii-scroll-container');
    if (container && 'ResizeObserver' in window) {
      const ro = new ResizeObserver(() => {
        refreshScrollCapacity();
      });
      ro.observe(container);
    }

    if ('fonts' in document) {
      document.fonts.ready.then(() => {
        refreshScrollCapacity();
      });
    }
  }

  let clockInterval: number | null = null;
  function ensureClockTimer() {
    const onBlog = window.location.pathname.startsWith('/blog');
    if (clockInterval !== null) {
      clearInterval(clockInterval);
      clockInterval = null;
    }
    if (!onBlog) {
      updateISTClock();
      clockInterval = window.setInterval(updateISTClock, 1000);
    }
  }

  setupControls();
  ensureClockTimer();
  window.addEventListener('scroll', () => {
    checkStuck();
  }, { passive: true });
  window.addEventListener('resize', refreshScrollCapacity);
  document.addEventListener('astro:after-swap', setupControls);
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      stopIdleAnimation();
    } else if (shouldAnimateIdle()) {
      startIdleAnimation();
    }
  });

  if (typeof window !== 'undefined' && window.matchMedia) {
    window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
      if (getStoredTheme() === 'device') {
        applyTheme('device');
      }
    });
  }

  // Keyboard navigation shortcuts: 'a' for accent, 't' for theme, 'e' for eyeline
  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement | null;
    const isInput = target && (
      target.tagName === 'INPUT' ||
      target.tagName === 'TEXTAREA' ||
      target.isContentEditable
    );
    if (isInput) return;
    if (e.key === 'a' || e.key === 'A') {
      const accentBtn = document.getElementById('accent-toggle');
      accentBtn?.click();
    } else if (e.key === 't' || e.key === 'T') {
      const themeBtn = document.getElementById('theme-toggle');
      themeBtn?.click();
    } else if (e.key === 'e' || e.key === 'E') {
      const eyelineBtn = document.getElementById('eyeline-toggle');
      eyelineBtn?.click();
    } else if (e.key === 'o' || e.key === 'O') {
      const opacityBtn = document.getElementById('eyeline-opacity-toggle');
      opacityBtn?.click();
    } else if (e.key === 'p' || e.key === 'P') {
      const posBtn = document.getElementById('eyeline-pos-toggle');
      posBtn?.click();
    }
  });
</script>

