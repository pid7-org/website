---
const buildDate = new Intl.DateTimeFormat('en-GB', {
  timeZone: 'Asia/Kolkata',
  day: '2-digit',
  month: 'short',
  year: 'numeric'
}).format(new Date());
---

<footer class="font-mono text-xs select-none">
	<p class="text-ctp-subtext0/60 text-xs font-mono text-center mb-10 sm:mb-14 tracking-wide">
		[padded at the bottom to maintain a consistent reading eyeline]
	</p>

	<div
		class="border border-ctp-surface1 bg-ctp-surface0/20 flex flex-nowrap items-stretch
			divide-x divide-ctp-surface1 text-xs w-full max-w-full overflow-hidden h-[34px]"
	>
		<!-- Left: Brand / System info -->
		<a
			href="/"
			class="flex items-center gap-1.5 px-3 sm:px-4 py-1.5 font-semibold text-[var(--color-accent)]
				hover:opacity-85 transition-opacity shrink-0"
			title="pid7 home"
		>
			<span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] inline-block"></span>
			<span>pid7</span>
		</a>

		<!-- Build date (hidden on very compact screens < 450px) -->
		<div
			class="hidden min-[450px]:flex items-center px-3 py-1.5 text-ctp-subtext0 gap-1.5
				whitespace-nowrap shrink-0"
		>
			<span class="text-ctp-subtext0/70">built:</span>
			<span class="text-ctp-subtext1">{buildDate}</span>
		</div>

		<!-- Middle: Technical Feeds & Metadata -->
		<div
			class="flex-1 min-w-0 flex items-center justify-center gap-2 sm:gap-4 px-2 sm:px-3
				py-1.5 text-ctp-subtext0 overflow-hidden whitespace-nowrap"
		>
			<a
				href="https://github.com/pid7-org"
				target="_blank"
				rel="noreferrer"
				class="hover:text-[var(--color-accent)] transition-colors truncate"
				title="GitHub organization"
			>
				github
			</a>
			<span class="text-ctp-surface2 select-none">/</span>
			<a
				href="/rss.xml"
				target="_blank"
				class="hover:text-[var(--color-accent)] transition-colors"
				title="RSS Feed"
			>
				rss
			</a>
			<span class="text-ctp-surface2 select-none">/</span>
			<a
				href="/sitemap.xml"
				target="_blank"
				class="hover:text-[var(--color-accent)] transition-colors"
				title="Sitemap"
			>
				sitemap
			</a>
		</div>

		<!-- Right: Back to top action with shortcut [b] -->
		<button
			id="footer-back-to-top"
			type="button"
			class="flex items-center justify-center gap-1 sm:gap-1.5 px-3 py-1.5 text-ctp-subtext1
				hover:text-ctp-text hover:bg-ctp-surface1/30 transition-colors cursor-pointer
				focus:outline-none whitespace-nowrap shrink-0"
			aria-label="Scroll back to top"
			title="Scroll back to top (or press 'b')"
		>
			<span class="text-ctp-subtext0">[b]</span>
			<span class="hidden min-[400px]:inline">top</span>
			<span class="text-[var(--color-accent)] font-semibold">↑</span>
		</button>
	</div>
</footer>

<script>
	const backToTopBtn = document.getElementById('footer-back-to-top');
	if (backToTopBtn) {
		backToTopBtn.addEventListener('click', () => {
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});
	}

	document.addEventListener('keydown', (e) => {
		const target = e.target as HTMLElement | null;
		const isInput = target && (
			target.tagName === 'INPUT' ||
			target.tagName === 'TEXTAREA' ||
			target.isContentEditable
		);
		if (isInput) return;

		if (e.key === 'b' || e.key === 'B') {
			window.scrollTo({ top: 0, behavior: 'smooth' });
		}
	});
</script>
