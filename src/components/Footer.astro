---
---

<footer class="font-mono text-xs space-y-4">
	<p class="text-ctp-subtext0/60 text-xs font-mono text-center tracking-wide">
		[padded at the bottom to maintain a consistent reading eyeline]
	</p>

	<div class="text-center overflow-x-auto whitespace-nowrap text-xs text-ctp-subtext0 py-2">
		<span class="text-ctp-overlay0">&#123;</span>
		<span class="mx-1">
			<span class="text-[var(--color-accent)]">"system"</span><span class="text-ctp-overlay0">:</span>
			<span class="text-ctp-text">"pid7"</span><span class="text-ctp-overlay0">,</span>
		</span>
		<span class="mx-1">
			<span class="text-[var(--color-accent)]">"version"</span><span class="text-ctp-overlay0">:</span>
			<span class="text-ctp-text">"v2.0.0"</span><span class="text-ctp-overlay0">,</span>
		</span>
		<span class="mx-1">
			<span class="text-[var(--color-accent)]">"clock"</span><span class="text-ctp-overlay0">:</span>
			<span id="footer-clock" class="text-ctp-text">"--:--:--"</span><span class="text-ctp-overlay0">,</span>
		</span>
		<span class="mx-1">
			<span class="text-[var(--color-accent)]">"locale"</span><span class="text-ctp-overlay0">:</span>
			<span class="text-ctp-text">"Asia/Kolkata"</span>
		</span>
		<span class="text-ctp-overlay0">&#125;</span>
	</div>
</footer>

<script>
	let clockInterval: number | null = null;

	function updateFooterClock() {
		const clockEl = document.getElementById('footer-clock');
		if (!clockEl) return;
		const now = new Date();
		const formatter = new Intl.DateTimeFormat('en-GB', {
			timeZone: 'Asia/Kolkata',
			hour: '2-digit',
			minute: '2-digit',
			second: '2-digit',
			hour12: false,
		});
		clockEl.textContent = `"${formatter.format(now)} IST"`;
	}

	function startClock() {
		if (clockInterval !== null) {
			clearInterval(clockInterval);
			clockInterval = null;
		}
		updateFooterClock();
		clockInterval = window.setInterval(updateFooterClock, 1000);
	}

	startClock();
	document.addEventListener('astro:after-swap', startClock);
	document.addEventListener('visibilitychange', () => {
		if (document.hidden) {
			if (clockInterval !== null) {
				clearInterval(clockInterval);
				clockInterval = null;
			}
		} else {
			startClock();
		}
	});
</script>
