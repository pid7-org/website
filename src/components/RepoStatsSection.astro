---
import ghData from '../assets/gh-data.json';

const cadence = ghData.cadence || {
  total_commits: 0,
};

const topRepos = ghData.top_repos || [];
const maxRepoCommits = Math.max(...topRepos.map((r) => r.commits), 1);
const BAR_SLOTS = 14;

function generateAsciiBar(commits: number): { filled: string; empty: string } {
  const filledCount = Math.max(1, Math.round((commits / maxRepoCommits) * BAR_SLOTS));
  const emptyCount = Math.max(0, BAR_SLOTS - filledCount);
  return {
    filled: '■'.repeat(filledCount),
    empty: '■'.repeat(emptyCount),
  };
}
---

{topRepos.length > 0 && (
  <section id="section-repo-stats" class="font-mono">
    <div class="mb-4 flex items-center gap-1.5 text-xs">
      <span class="text-[var(--color-accent)] font-semibold">~</span>
      <span class="text-ctp-overlay1">$</span>
      <span class="text-ctp-subtext0 tracking-wide">git stats --top-repos</span>
    </div>

    <div class="space-y-1 overflow-x-auto">
      <!-- Table Header -->
      <div class="flex items-center justify-between text-[10px] text-ctp-subtext0/70 uppercase tracking-wider py-1 border-b border-ctp-surface0/30 min-w-[380px]">
        <span class="w-[30%]">Repository</span>
        <span class="w-[12%]">Lang</span>
        <span class="w-[34%] text-center">Activity</span>
        <span class="w-[12%] text-right">Commits</span>
        <span class="w-[12%] text-right">Net LOC</span>
      </div>

      <!-- Table Rows -->
      <div class="divide-y divide-ctp-surface0/20 min-w-[380px]">
        {topRepos.slice(0, 4).map((repo) => {
          const { filled, empty } = generateAsciiBar(repo.commits);
          const ratioPct = Math.round((repo.commits / (cadence.total_commits || 1)) * 100);

          return (
            <div class="group flex items-center justify-between text-xs font-mono py-2 transition-colors hover:bg-ctp-surface0/10">
              <div class="w-[30%] min-w-0 pr-2">
                <a
                  href={repo.url}
                  target="_blank"
                  rel="noreferrer"
                  class="font-medium text-ctp-text group-hover:text-[var(--color-accent)] transition-colors truncate block"
                >
                  {repo.name}
                </a>
              </div>

              <span class="w-[12%] text-[10px] text-ctp-subtext0">
                {repo.primaryLanguage.toLowerCase()}
              </span>

              <div class="w-[34%] flex items-center justify-center gap-2 font-mono text-[11px]">
                <div class="inline-flex tracking-tight">
                  <span class="text-[var(--color-accent)]">{filled}</span>
                  <span class="text-ctp-surface1/40">{empty}</span>
                </div>
                <span class="text-[10px] text-ctp-subtext0 w-[3ch] text-right">
                  {ratioPct}%
                </span>
              </div>

              <span class="w-[12%] text-right text-ctp-text font-medium">
                {repo.commits}
              </span>

              <span class="w-[12%] text-right text-ctp-subtext0">
                +{Math.round(repo.net_loc / 1000)}k
              </span>
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}
