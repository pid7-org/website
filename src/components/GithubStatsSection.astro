---
import ghData from '../assets/gh-data.json';
import {
  generateAsciiBar as createAsciiBar,
  projectCumulativeCurve,
  generateSvgAreaPath,
} from '../lib/chart/projection.ts';

const cadence = ghData.cadence || {
  total_commits: 0,
  total_prs: 0,
  total_releases: 0,
  monthly_avg_commits: 0,
  merge_rate_pct: 100,
};

const topRepos = ghData.top_repos || [];
const cumulativePoints = ghData.cumulative_commits || [];
const totalNetLoc = ghData.total_net_loc || 0;

// Relative ASCII bar generator helper
const maxRepoCommits = Math.max(...topRepos.map((r) => r.commits), 1);
const BAR_SLOTS = 14;

function generateAsciiBar(commits: number): { filled: string; empty: string } {
  return createAsciiBar(commits, maxRepoCommits, BAR_SLOTS);
}

// Plotted SVG curve calculations
const svgWidth = 760;
const svgHeight = 150;
const pad = { top: 15, right: 15, bottom: 25, left: 45 };
const plotW = svgWidth - pad.left - pad.right;
const plotH = svgHeight - pad.top - pad.bottom;

const maxCommits = Math.max(...cumulativePoints.map((p) => p.cumulative), 1);

const yTicks = [
  Math.round(maxCommits * 0.1),
  Math.round(maxCommits * 0.55),
  maxCommits,
];

const plotPoints = projectCumulativeCurve(
  cumulativePoints,
  { width: svgWidth, height: svgHeight },
  pad
);

const polylineStr = plotPoints.map((pt) => `${pt.x},${pt.y}`).join(' ');
const baselineY = pad.top + plotH;
const areaPathD = generateSvgAreaPath(plotPoints, baselineY);

function formatDayMonth(dateStr: string): string {
  const parts = dateStr.split('-');
  if (parts.length === 3) {
    return `${parts[2]}-${parts[1]}`;
  }
  return dateStr;
}

const xTickStep = Math.max(1, Math.floor(plotPoints.length / 5));
const rawTicks = plotPoints.filter((_, idx) => idx % xTickStep === 0 || idx === plotPoints.length - 1);
const xTicks = rawTicks.filter((pt, idx, arr) => {
  if (idx < arr.length - 1) {
    const nextPt = arr[idx + 1];
    if (Math.abs(nextPt.x - pt.x) < 40) {
      return false;
    }
  }
  return true;
});
---

<section id="section-telemetry" class="w-full font-mono">
  <!-- Command Header -->
  <div class="mb-4 flex items-center gap-1.5 text-xs">
    <span class="text-[var(--color-accent)] font-semibold">~</span>
    <span class="text-ctp-overlay1">$</span>
    <span class="text-ctp-subtext0 tracking-wide">cat telemetry.log</span>
  </div>

  <div class="space-y-6">
    <!-- 1. Top Cadence Ribbon -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs border-b border-ctp-surface0/40 pb-4">
    <div class="space-y-0.5">
      <span class="text-ctp-subtext0 text-[11px] block">Commits</span>
      <span class="text-base sm:text-lg font-bold text-ctp-text font-serif">
        {cadence.total_commits.toLocaleString()}
      </span>
    </div>
    <div class="space-y-0.5">
      <span class="text-ctp-subtext0 text-[11px] block">Releases</span>
      <span class="text-base sm:text-lg font-bold text-ctp-text font-serif">
        {cadence.total_releases.toLocaleString()}
      </span>
    </div>
    <div class="space-y-0.5">
      <span class="text-ctp-subtext0 text-[11px] block">Net LOC</span>
      <span class="text-base sm:text-lg font-bold text-ctp-text font-serif">
        +{Math.round(totalNetLoc / 1000)}k
      </span>
    </div>
    <div class="space-y-0.5">
      <span class="text-ctp-subtext0 text-[11px] block">Merge Rate</span>
      <span class="text-base sm:text-lg font-bold text-ctp-text font-serif">
        {cadence.merge_rate_pct}%
      </span>
    </div>
  </div>

  <!-- 2. Velocity Curve Graph (Positioned Above the Repo Table) -->
  <div class="space-y-2">
    <div class="relative w-full overflow-hidden" id="commits-chart-container">
      <svg
        class="w-full h-32 sm:h-36 overflow-visible cursor-crosshair select-none"
        viewBox={`0 0 ${svgWidth} ${svgHeight}`}
        preserveAspectRatio="none"
        id="commits-curve-svg"
      >
        <defs>
          <linearGradient id="curveGradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.22" />
            <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0.0" />
          </linearGradient>
        </defs>

        <!-- Horizontal Guide Lines -->
        {yTicks.map((val) => {
          const y = pad.top + plotH - (val / maxCommits) * plotH;
          return (
            <g class="text-[10px] font-mono fill-ctp-subtext0/50 select-none">
              <line
                x1={pad.left}
                y1={y}
                x2={svgWidth - pad.right}
                y2={y}
                stroke="currentColor"
                stroke-dasharray="3 3"
                class="text-ctp-surface1/40"
                stroke-width="1"
              />
              <text x={pad.left - 6} y={y + 3} text-anchor="end">
                {val >= 1000 ? `${(val / 1000).toFixed(1)}k` : val}
              </text>
            </g>
          );
        })}

        <!-- Baseline -->
        <line
          x1={pad.left}
          y1={baselineY}
          x2={svgWidth - pad.right}
          y2={baselineY}
          class="text-ctp-surface1/60"
          stroke="currentColor"
          stroke-width="1"
        />

        <!-- Milestone dates along X-axis -->
        {xTicks.map((pt) => (
          <g class="text-[10px] font-mono fill-ctp-subtext0/60 select-none">
            <text x={pt.x} y={baselineY + 14} text-anchor="middle">
              {formatDayMonth(pt.date)}
            </text>
          </g>
        ))}

        <!-- Area Fill and Stroke -->
        <path d={areaPathD} fill="url(#curveGradient)" />
        <polyline
          fill="none"
          stroke="var(--color-accent)"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          points={polylineStr}
        />

        <!-- Interactive Scrub Elements -->
        <line
          id="guide-line"
          x1="0"
          y1={pad.top}
          x2="0"
          y2={baselineY}
          stroke="var(--color-accent)"
          stroke-width="1"
          stroke-dasharray="2 2"
          class="opacity-0 transition-opacity pointer-events-none"
        />
        <circle
          id="guide-dot"
          cx="0"
          cy="0"
          r="3.5"
          fill="var(--color-accent)"
          class="opacity-0 transition-opacity pointer-events-none"
        />
      </svg>

      <!-- Tooltip -->
      <div
        id="chart-tooltip"
        class="hidden absolute pointer-events-none bg-ctp-surface0/95 border border-ctp-surface1
               px-2 py-1 text-[11px] font-mono shadow-md backdrop-blur-sm z-10 space-y-0.5"
      >
        <div id="tooltip-date" class="text-ctp-subtext0 text-[10px]"></div>
        <div id="tooltip-value" class="text-ctp-text font-semibold"></div>
        <div id="tooltip-delta" class="text-[var(--color-accent)] text-[10px]"></div>
      </div>
    </div>
  </div>
  </div>
</section>

<script define:vars={{ plotPoints, svgWidth, svgHeight: 150 }}>
  function initCurveInteractivity() {
    const svg = document.getElementById('commits-curve-svg');
    const guideLine = document.getElementById('guide-line');
    const guideDot = document.getElementById('guide-dot');
    const tooltip = document.getElementById('chart-tooltip');
    const tDate = document.getElementById('tooltip-date');
    const tVal = document.getElementById('tooltip-value');
    const tDelta = document.getElementById('tooltip-delta');

    if (!svg || !guideLine || !guideDot || !tooltip || !tDate || !tVal || !tDelta) {
      return;
    }

    svg.addEventListener('mousemove', (e) => {
      const rect = svg.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const targetSvgX = (mouseX / rect.width) * svgWidth;

      let nearest = plotPoints[0];
      let minDiff = Infinity;
      for (const pt of plotPoints) {
        const diff = Math.abs(pt.x - targetSvgX);
        if (diff < minDiff) {
          minDiff = diff;
          nearest = pt;
        }
      }

      if (!nearest) return;

      guideLine.setAttribute('x1', String(nearest.x));
      guideLine.setAttribute('x2', String(nearest.x));
      guideDot.setAttribute('cx', String(nearest.x));
      guideDot.setAttribute('cy', String(nearest.y));

      guideLine.classList.remove('opacity-0');
      guideDot.classList.remove('opacity-0');

      tDate.textContent = nearest.date;
      tVal.textContent = `${nearest.cumulative.toLocaleString()} commits`;
      tDelta.textContent = `+${nearest.interval_delta} in 14-day window`;

      tooltip.classList.remove('hidden');

      const tooltipX = (nearest.x / svgWidth) * rect.width;
      const tooltipY = (nearest.y / 150) * rect.height;

      let leftPos = tooltipX + 10;
      if (leftPos + 140 > rect.width) {
        leftPos = tooltipX - 150;
      }

      tooltip.style.left = `${Math.max(4, leftPos)}px`;
      tooltip.style.top = `${Math.max(4, tooltipY - 35)}px`;
    });

    svg.addEventListener('mouseleave', () => {
      guideLine.classList.add('opacity-0');
      guideDot.classList.add('opacity-0');
      tooltip.classList.add('hidden');
    });
  }

  initCurveInteractivity();
  document.addEventListener('astro:after-swap', initCurveInteractivity);
</script>
