---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="font-mono">
	<div class="flex items-center min-w-0">
		<h1
			class="font-barcode text-4xl sm:text-5xl font-normal leading-none tracking-normal
				transition-colors duration-300"
			style="color: var(--color-accent);"
		>
			<a href="/" class="hover:opacity-85 transition-opacity inline-block">pid7</a>
		</h1>
	</div>
</header>

<div id="status-bar-sentinel" class="w-full h-px pointer-events-none opacity-0 -mb-px"></div>

<div id="status-bar-sticky-wrap" class="mt-3 sm:mt-4 h-[34px]">
	<ThemeToggle />
</div>
