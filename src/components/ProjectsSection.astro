---
import { projects, type Project, type ProjectLanguageStat } from '../lib/projects';

function getReleaseTimestamp(p: Project): number {
  if (p.latestRelease?.publishedAt) {
    const t = new Date(p.latestRelease.publishedAt).getTime();
    if (!isNaN(t)) return t;
  }
  return 0;
}

function compareProjectsByRelease(a: Project, b: Project): number {
  const timeA = getReleaseTimestamp(a);
  const timeB = getReleaseTimestamp(b);
  if (timeA !== timeB) {
    return timeB - timeA;
  }
  return (b.contributions ?? b.commits ?? 0) - (a.contributions ?? a.commits ?? 0);
}

// Show only projects that have banner.jpg present and have a release, ordered newest first
const allProjects = projects
  .filter((p) => Boolean(p.bannerUrl) && Boolean(p.latestRelease?.publishedAt))
  .sort(compareProjectsByRelease);

function getTopLanguages(project: Project): ProjectLanguageStat[] {
  if (Array.isArray(project.languages) && project.languages.length > 0) {
    return project.languages.slice(0, 2);
  }
  if (project.language) {
    return [{ name: project.language, color: project.languageColor ?? null, bytes: 0 }];
  }
  return [];
}
---

{allProjects.length > 0 && (
  <section id="section-projects" class="font-mono">
    <div class="mb-4 flex items-center gap-1.5 text-xs select-none">
      <span class="text-[var(--color-accent)] font-semibold">~</span>
      <span class="text-ctp-overlay1">$</span>
      <span class="text-ctp-subtext0 tracking-wide">ls -l projects/</span>
    </div>

    <div class="space-y-4">
      {allProjects.map((project) => (
        <article class="group rounded border border-ctp-surface0/60 bg-ctp-mantle/40 transition-colors duration-200 hover:border-[var(--color-accent)]/60">
          <a
            href={project.url}
            target="_blank"
            rel="noreferrer"
            class="block focus:outline-none"
          >
            <!-- TUI Header / Title Bar -->
            <div class="flex items-center justify-between gap-3 px-3.5 py-2 border-b border-ctp-surface0/60 bg-ctp-surface0/20 text-xs">
              <span class="flex items-center gap-2 min-w-0 font-serif text-sm sm:text-base text-ctp-text font-medium transition-colors group-hover:text-[var(--color-accent)]">
                <span class="inline-flex font-mono text-xs select-none shrink-0 tracking-[-0.2em] group-hover:tracking-normal transition-all duration-200 text-ctp-subtext0/60 group-hover:text-[var(--color-accent)]">
                  <span>&rsaquo;</span>
                  <span class="inline-block max-w-0 opacity-0 overflow-hidden group-hover:max-w-[2ch] group-hover:opacity-100 transition-all duration-200 ease-out">&rsaquo;&rsaquo;</span>
                </span>
                <span class="truncate">{project.name}</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-ctp-subtext0 group-hover:text-[var(--color-accent)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform shrink-0"
                >
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </span>

              <div class="flex items-center gap-1.5 font-mono text-[11px] text-ctp-subtext0 shrink-0 select-none">
                {getTopLanguages(project).map((lang) => (
                  <span class="text-ctp-subtext1">[{lang.name.toLowerCase()}]</span>
                ))}
                {project.latestRelease && (
                  <span class="text-ctp-subtext1">[{project.latestRelease.tagName}]</span>
                )}
              </div>
            </div>

            <!-- Card Body: Banner + Metadata -->
            <div class="p-3 sm:p-3.5 flex flex-col sm:flex-row gap-3.5 items-start">
              {project.bannerUrl && (
                <div class="w-full sm:w-44 aspect-[16/9] sm:shrink-0 overflow-hidden rounded border border-ctp-surface0/70 bg-ctp-crust">
                  <img
                    src={project.bannerUrl}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover object-center opacity-85 transition-opacity duration-300 group-hover:opacity-100"
                  />
                </div>
              )}

              <div class="flex-1 min-w-0 flex flex-col justify-between self-stretch space-y-2.5">
                <p class="font-mono text-xs text-ctp-subtext0 leading-relaxed line-clamp-3">
                  {project.desc}
                </p>

                <div class="flex items-center gap-3 font-mono text-[11px] text-ctp-subtext0/70 select-none pt-1">
                  <span>{project.commits} commits</span>
                  {project.releases !== undefined && (
                    <span>&bull; {project.releases} releases</span>
                  )}
                  {project.stars !== undefined && project.stars > 0 && (
                    <span>&bull; ★ {project.stars}</span>
                  )}
                </div>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
)}

