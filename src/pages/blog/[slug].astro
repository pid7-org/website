---
import Layout from '../../layouts/Layout.astro';
import { formatBlogDate, getAllBlogPosts, getBlogPostById } from '../../lib/blog';
import type { ParsedBlogPost } from 'mdparser';

export async function getStaticPaths() {
  const posts = await getAllBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.frontmatter.slug },
    props: { post },
  }));
}

interface Props {
  post: ParsedBlogPost;
}

const { post } = Astro.props;

const cleanContent = post.rawMarkdown
  .replace(/^---[\s\S]*?---/, '')
  .replace(/<[^>]*>/g, '')
  .replace(/\{@[^}]*\}/g, '')
  .replace(/\[\^[^\]]*\]/g, '')
  .replace(/#+\s+/g, '')
  .replace(/[\*\_`~]/g, '')
  .replace(/\s+/g, ' ')
  .trim();

const fallbackExcerpt = cleanContent.length > 160
  ? cleanContent.slice(0, 160).slice(0, Math.max(120, cleanContent.slice(0, 160).lastIndexOf(' '))) + '...'
  : cleanContent;

const pageDescription = post.frontmatter.description || fallbackExcerpt || 'engineering ideas into reality';
---

<Layout
  title={`pid7 × ${post.frontmatter.title}`}
  description={pageDescription}
  type="article"
  publishedTime={post.frontmatter.created}
  modifiedTime={post.frontmatter.lastUpdated}
  tags={post.frontmatter.tags}
>
		<div
			id="blog-eyeline"
			class="fixed top-[30vh] left-0 right-0 pointer-events-none z-20 border-b border-dashed
				border-[var(--color-accent)] flex items-center justify-end px-4 sm:px-8 select-none
				transition-[top,opacity] duration-150"
			style="opacity: 0.80;"
		>
			<span class="font-mono text-[9px] uppercase tracking-widest text-[var(--color-accent)]">
				eyeline
			</span>
		</div>

		<script is:inline>
			(function () {
				const el = document.getElementById('blog-eyeline');
				if (!el) return;

				let config = { enabled: true, opacity: 80, pos: 30 };
				try {
					const saved = localStorage.getItem('pid7_eyeline');
					if (saved) {
						const parsed = JSON.parse(saved);
						if (typeof parsed.enabled === 'boolean') config.enabled = parsed.enabled;
						if (typeof parsed.opacity === 'number') config.opacity = parsed.opacity;
						if (typeof parsed.pos === 'number') config.pos = parsed.pos;
					} else {
						localStorage.setItem('pid7_eyeline', JSON.stringify(config));
					}
				} catch {}

				function applyConfig(cfg) {
					if (typeof cfg.enabled === 'boolean') {
						el.style.display = cfg.enabled ? 'flex' : 'none';
					}
					if (typeof cfg.opacity === 'number') {
						el.style.opacity = (cfg.opacity / 100).toFixed(2);
					}
					if (typeof cfg.pos === 'number') {
						el.style.top = `${cfg.pos}vh`;
					}
				}

				applyConfig(config);

				window.__eyeline = {
					getConfig: () => ({ ...config }),
					setConfig: (newCfg) => {
						config = { ...config, ...newCfg };
						applyConfig(config);
						try {
							localStorage.setItem('pid7_eyeline', JSON.stringify(config));
						} catch {}
						return { ...config };
					}
				};
			})();
		</script>

		<header class="space-y-2.5 sm:space-y-3">
			<h1 class="font-serif text-2xl sm:text-4xl font-semibold tracking-tight text-ctp-text leading-tight break-words">
				{post.frontmatter.title}
			</h1>

			<div class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-ctp-subtext0">
				<span>{formatBlogDate(post.frontmatter.created)}</span>
				<span class="text-ctp-surface1">•</span>
				<span>{post.readTimeMinutes} min read</span>
				<span class="text-ctp-surface1">•</span>
				<span>{post.wordCount} words</span>
			</div>
		</header>

		<article id="section-article" class="prose max-w-none font-mono leading-relaxed text-ctp-text space-y-5 sm:space-y-6 min-w-0">
			<div set:html={post.html} />
		</article>

		<div class="mt-6 sm:mt-8 flex flex-wrap items-center justify-between gap-3 sm:gap-4 font-mono text-xs text-ctp-subtext0 border-t border-ctp-surface0/40 pt-4">
			<div class="flex flex-wrap items-center gap-2">
				{post.frontmatter.tags.map((tag) => (
					<span class="text-[10px] sm:text-xs px-2 py-0.5 border border-ctp-surface1 bg-ctp-surface0/40 text-ctp-subtext1">
						#{tag}
					</span>
				))}
			</div>
			{post.frontmatter.lastUpdated && post.frontmatter.lastUpdated !== post.frontmatter.created && (
				<span class="text-ctp-subtext0 text-xs select-none">
					last updated on {formatBlogDate(post.frontmatter.lastUpdated)}
				</span>
			)}
		</div>

		{post.glossary.length > 0 && (
			<section id="section-glossary" class="font-mono mt-8 sm:mt-12">
				<h2 id="glossary" class="mb-3 font-mono text-xs uppercase tracking-widest text-ctp-subtext0">
					Glossary
				</h2>

				<div class="space-y-3">
					{post.glossary.map((item) => (
						<div class="border-l border-ctp-surface1 hover:border-[var(--color-accent)] transition-colors duration-200 pl-3.5 sm:pl-4 py-1 space-y-1 min-w-0">
							<div class="font-mono text-xs sm:text-sm font-semibold text-ctp-text">
								{item.term}
							</div>
							<div class="font-mono text-xs sm:text-sm text-ctp-subtext0 leading-relaxed break-words" set:html={item.definitionHtml} />
						</div>
					))}
				</div>
			</section>
		)}

		{post.references.length > 0 && (
			<section id="section-references" class="font-mono mt-8 sm:mt-12">
				<h2 id="references" class="mb-3 font-mono text-xs uppercase tracking-widest text-ctp-subtext0">
					References
				</h2>

				<ol class="space-y-3">
					{post.references.map((ref) => (
						<li id={`fn-${ref.id}`} class="border-l border-ctp-surface1 hover:border-[var(--color-accent)] transition-colors duration-200 pl-3.5 sm:pl-4 py-1 flex items-start gap-2.5 sm:gap-3 text-xs sm:text-sm">
							<span class="font-mono text-xs font-semibold text-[var(--color-accent)] shrink-0 mt-0.5">
								[{ref.label}]
							</span>
							<div class="space-y-2 flex-1 min-w-0">
								<div class="leading-relaxed text-ctp-subtext0 break-words" set:html={ref.contentHtml} />
							</div>
							<a
								href={`#fnref-${ref.id}`}
								class="font-mono text-xs text-ctp-subtext0 hover:text-[var(--color-accent)] transition-colors shrink-0 select-none"
								title="Back to text"
							>
								↩
							</a>
						</li>
					))}
				</ol>
			</section>
		)}

		<div class="h-[40vh]"></div>

</Layout>

<script>
  function setupCopyButtons() {
    document.querySelectorAll('.copy-code-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const encodedCode = btn.getAttribute('data-code');
        let textToCopy = '';
        if (encodedCode) {
          textToCopy = decodeURIComponent(encodedCode);
        } else {
          const card = btn.closest('.custom-code-block');
          const codeEl = card?.querySelector('.code-body pre code');
          textToCopy = codeEl?.textContent || '';
        }

        try {
          await navigator.clipboard.writeText(textToCopy);
        } catch (err) {
          console.error('Failed to copy code to clipboard', err);
        }
      });
    });
  }

  setupCopyButtons();

  document.addEventListener('astro:after-swap', () => {
    setupCopyButtons();
  });
</script>
