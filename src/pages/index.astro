---
import Layout from '../layouts/Layout.astro';
import GithubStatsSection from '../components/GithubStatsSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import { formatBlogDate, getAllBlogPosts } from '../lib/blog';

const posts = await getAllBlogPosts();
const recentPosts = posts.slice(0, 5);
---

<Layout>
	<section id="section-quote" class="font-mono">
		<blockquote
			class="pl-3.5 sm:pl-4 border-l border-ctp-surface1 hover:border-[var(--color-accent)]
				transition-colors py-0.5 space-y-1.5"
		>
			<p class="text-sm sm:text-base text-ctp-text leading-relaxed">
				&ldquo;You can't trust code that you did not totally create yourself&rdquo;
			</p>
			<footer class="text-xs text-ctp-subtext0">
				&mdash; Ken Thompson, <cite class="not-italic text-ctp-subtext1">Reflections on Trusting Trust</cite>
			</footer>
		</blockquote>
	</section>

	{recentPosts.length > 0 && (
		<section id="section-blogs">
			<h2 class="mb-3 font-mono text-xs uppercase tracking-widest text-ctp-subtext0">
				Blogs
			</h2>
			<ul class="text-sm space-y-1">
				{recentPosts.map((post) => (
					<li class="group flex items-baseline justify-between gap-4 py-2 border-b border-ctp-surface0/40 last:border-0">
						<a
							href={`/blog/${post.frontmatter.slug}`}
							class="font-serif text-base text-ctp-text font-medium transition-colors hover:text-[var(--color-accent)] leading-snug"
						>
							{post.frontmatter.title}
						</a>
						<span class="shrink-0 font-mono text-xs text-ctp-subtext0 select-none">
							{formatBlogDate(post.frontmatter.created)}
						</span>
					</li>
				))}
			</ul>
		</section>
	)}

	<ProjectsSection />

	<GithubStatsSection />

	<div class="h-[40vh]"></div>
</Layout>
